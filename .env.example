# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Generate passwords/keys with: openssl rand -hex 24

# --- Postgres (used by docker-compose and sql/00_init.sh on first start) ---
POSTGRES_ADMIN_USER=pgadmin
POSTGRES_ADMIN_PASSWORD=
N8N_DB_PASSWORD=
# n8n writes run logs with this role (insert/update only, no delete)
COPILOT_WRITER_PASSWORD=
# KPI queries and dashboards use this role (select only)
COPILOT_READER_PASSWORD=

# --- n8n ---
# Encrypts credentials stored in n8n. Losing it means re-entering all credentials.
N8N_ENCRYPTION_KEY=
WEBHOOK_URL=http://127.0.0.1:5678/
# "all" while building, "none" once the workflow is stable (errors are always kept)
EXECUTIONS_SAVE_ON_SUCCESS=all

# --- Data sources (used by local check scripts; in n8n these live in credentials) ---
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# --- Loaded into n8n credentials by scripts/import_credentials.py ---
# console.anthropic.com -> Settings -> API Keys (set a monthly spend limit too)
ANTHROPIC_API_KEY=
# Day 1 step 4: Telegram bot for human approval
TELEGRAM_BOT_TOKEN=
# Header token for the test-runner webhook (scripts/run_batch.sh). openssl rand -hex 24
TEST_RUNNER_TOKEN=
# Your Telegram chat ID; scripts write it to data/private/settings.json (git-ignored)
TELEGRAM_CHAT_ID=
